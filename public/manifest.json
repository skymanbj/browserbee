{
  "action": {
    "default_icon": {
      "128": "icons/icon128.png",
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    },
    "default_title": "BrowserBee 🐝"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "description": "Open the BrowserBee side panel",
      "global": false,
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      }
    }
  },
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "optional_host_permissions": [],
  "oauth2": {
    "client_id": "916519454233-0e0a60gghk8odlgo6shnk80iefhbh7o5.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 3,
  "name": "BrowserBee 🐝",
  "options_page": "options.html",
  "permissions": [
    "tabs",
    "sidePanel",
    "storage",
    "activeTab",
    "commands",
    "alarms",
    "debugger",
    "identity"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "version": "0.3.0"
}